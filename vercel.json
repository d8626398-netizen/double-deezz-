{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "admin.html",
          "menu.json",
          "orders.json",
          "firebase-config.js",
          "logo.png",
          "logo.jpg",
          "logo-icon.png",
          "instagram-qr.jpg",
          "menu-qr.jpg"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
