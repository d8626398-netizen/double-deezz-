# Double Deezz The Food Cafe - Firebase Environment Configuration
# Copy this file to .env or paste these values into the Admin Portal (Settings -> Firebase Cloud Integration)

FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=double-deezz-cafe.firebaseapp.com
FIREBASE_PROJECT_ID=double-deezz-cafe
FIREBASE_STORAGE_BUCKET=double-deezz-cafe.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional Server Port
PORT=3000
